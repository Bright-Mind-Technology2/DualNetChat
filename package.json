{
  "name": "bright-mind-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "setup:https": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-https.ps1",
    "enable:https": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/enable-https.ps1",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.2.1",
    "lucide-react": "^1.51.0",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
